  "cards": [
    {
      "dot": "cyan",
      "title": "What gets signed",
      "items": [
        "Card: server key signs the content id (sha256 of canonical JSON)",
        "Receipt: server key signs callId, glyphId and input/output hashes",
        "Update manifest and key registry: signed chain for rotation"
      ]
    },
    {
      "dot": "rose",
      "title": "Where a call stops",
      "items": [
        "Client: unknown or breaking card, revoked tool, untrusted key, missing attestation",
        "Server: invalid input 400, missing scope 403, missing or bad token 403",
        "secureMode: receipt key, signature, id or hash mismatch"
      ]
    },
    {
      "dot": "amber",
      "title": "Opt-in, not automatic",
      "items": [
        "Provider trust and attestation run only when configured",
        "Reviewing a confirmation ticket is up to the consumer",
        "The client does not fetch /keys during a call"
      ]
    }
  ]
