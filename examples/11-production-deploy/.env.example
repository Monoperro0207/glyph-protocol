# Generate via: pnpm exec glyph keys init --file ./keys.json
GLYPH_PUBLIC_KEY=
GLYPH_PRIVATE_KEY=

# Long, randomly-generated, rotated regularly.
GLYPH_AUTH_TOKEN=

# Optional — defaults to glyph.production
GLYPH_SERVER_ID=

# Optional — exposed by Caddy for TLS. Use a real hostname in production.
GLYPH_DOMAIN=localhost
