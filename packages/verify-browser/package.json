{
  "name": "@glyphp/verify-browser",
  "version": "0.0.0",
  "private": true,
  "description": "Browser-native Glyph verification — canonical ids, ed25519 signatures, and receipt bindings, with a verification trace a UI can render",
  "license": "Apache-2.0",
  "author": "Patrick Espino",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Monoperro0207/glyph-protocol.git",
    "directory": "packages/verify-browser"
  },
  "homepage": "https://github.com/Monoperro0207/glyph-protocol#readme",
  "bugs": "https://github.com/Monoperro0207/glyph-protocol/issues",
  "keywords": [
    "glyph",
    "glyph-protocol",
    "ed25519",
    "verification",
    "browser",
    "webmcp"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@glyphp/types": "workspace:*",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@glyphp/core": "workspace:*"
  }
}
