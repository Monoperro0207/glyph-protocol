{
  "name": "@glyphp/adapter-openapi",
  "version": "3.1.2",
  "description": "Convert an OpenAPI 3.x document into registerable Glyph Protocol glyphs",
  "license": "Apache-2.0",
  "author": "Patrick Espino",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Monoperro0207/glyph-protocol.git",
    "directory": "packages/adapters/openapi"
  },
  "homepage": "https://github.com/Monoperro0207/glyph-protocol#readme",
  "bugs": "https://github.com/Monoperro0207/glyph-protocol/issues",
  "keywords": [
    "glyph",
    "glyph-protocol",
    "openapi",
    "adapter"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@glyphp/core": "workspace:*",
    "@glyphp/server": "workspace:*",
    "@glyphp/types": "workspace:*",
    "zod": "^4.5.2"
  }
}
