{
  "name": "@glyphp/server",
  "version": "0.1.0",
  "description": "Glyph Protocol server built on Hono — serve signed, self-describing glyph cards",
  "license": "Apache-2.0",
  "author": "Patrick Espino",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Monoperro0207/glyph-protocol.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/Monoperro0207/glyph-protocol#readme",
  "bugs": "https://github.com/Monoperro0207/glyph-protocol/issues",
  "keywords": ["glyph", "glyph-protocol", "server", "hono", "llm"],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@glyphp/types": "workspace:*",
    "@glyphp/core": "workspace:*",
    "hono": "^4.3.9",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.0",
    "@hono/node-server": "^1.11.4"
  }
}
