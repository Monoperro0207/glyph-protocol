{
  "name": "@glyphp/server",
  "version": "1.4.1",
  "description": "Glyph Protocol server built on Hono — serve signed, self-describing glyph cards",
  "license": "Apache-2.0",
  "author": "Patrick Espino",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Monoperro0207/glyph-protocol.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/Monoperro0207/glyph-protocol#readme",
  "bugs": "https://github.com/Monoperro0207/glyph-protocol/issues",
  "keywords": [
    "glyph",
    "glyph-protocol",
    "server",
    "hono",
    "llm"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@alcyone-labs/zod-to-json-schema": "4.0.10",
    "@glyphp/core": "workspace:*",
    "@glyphp/types": "workspace:*",
    "@hono/node-server": "^2.0.6",
    "hono": "^4.12.26",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.23.0"
  }
}
