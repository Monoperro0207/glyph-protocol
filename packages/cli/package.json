{
  "name": "@glyphp/cli",
  "version": "1.3.0",
  "description": "Command-line tool for the Glyph Protocol — inspect, verify, and scaffold",
  "license": "Apache-2.0",
  "author": "Patrick Espino",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "bin": {
      "glyph": "./dist/cli.js",
      "glyphp": "./dist/glyphp.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Monoperro0207/glyph-protocol.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Monoperro0207/glyph-protocol#readme",
  "bugs": "https://github.com/Monoperro0207/glyph-protocol/issues",
  "keywords": [
    "glyph",
    "glyph-protocol",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@glyphp/adapter-mcp": "workspace:*",
    "@glyphp/client": "workspace:*",
    "@glyphp/core": "workspace:*",
    "@glyphp/types": "workspace:*",
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ink": "^7.0.5",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@glyphp/server": "workspace:*",
    "@types/react": "^19.2.0",
    "ink-testing-library": "^4.0.0",
    "zod": "^4.4.3"
  }
}
