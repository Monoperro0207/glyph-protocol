{
  "name": "@glyphp/cli",
  "version": "0.3.1",
  "description": "Command-line tool for the Glyph Protocol — inspect, verify, and scaffold",
  "license": "Apache-2.0",
  "author": "Patrick Espino",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "bin": {
      "glyph": "./dist/cli.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Monoperro0207/glyph-protocol.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Monoperro0207/glyph-protocol#readme",
  "bugs": "https://github.com/Monoperro0207/glyph-protocol/issues",
  "keywords": [
    "glyph",
    "glyph-protocol",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@glyphp/client": "workspace:*",
    "@glyphp/core": "workspace:*",
    "@glyphp/types": "workspace:*"
  },
  "devDependencies": {
    "@glyphp/server": "workspace:*",
    "zod": "^3.23.8"
  }
}
