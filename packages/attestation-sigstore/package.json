{
  "name": "@glyphp/attestation-sigstore",
  "version": "0.0.2",
  "description": "Opt-in AttestationVerifier performing real cryptographic Sigstore-bundle verification (DSSE + certificate chain) with RFC-0008 subject-digest binding",
  "license": "Apache-2.0",
  "author": "Patrick Espino",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Monoperro0207/glyph-protocol.git",
    "directory": "packages/attestation-sigstore"
  },
  "homepage": "https://github.com/Monoperro0207/glyph-protocol#readme",
  "bugs": "https://github.com/Monoperro0207/glyph-protocol/issues",
  "keywords": [
    "glyph",
    "glyph-protocol",
    "attestation",
    "sigstore",
    "dsse",
    "slsa",
    "supply-chain"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@glyphp/core": "workspace:*",
    "@glyphp/types": "workspace:*",
    "@sigstore/bundle": "^5.0.0",
    "@sigstore/verify": "^4.1.2"
  },
  "devDependencies": {
    "@glyphp/client": "workspace:*"
  }
}
