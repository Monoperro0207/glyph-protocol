{
  "name": "@glyphp/conformance",
  "version": "1.0.3",
  "description": "Conformance suite — validate any Glyph server against the protocol spec",
  "license": "Apache-2.0",
  "author": "Patrick Espino",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "bin": {
      "glyph-conformance": "./dist/cli.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Monoperro0207/glyph-protocol.git",
    "directory": "packages/conformance"
  },
  "homepage": "https://github.com/Monoperro0207/glyph-protocol#readme",
  "bugs": "https://github.com/Monoperro0207/glyph-protocol/issues",
  "keywords": [
    "glyph",
    "glyph-protocol",
    "conformance",
    "testing"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@glyphp/core": "workspace:*",
    "@glyphp/types": "workspace:*",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@glyphp/server": "workspace:*",
    "zod": "^4.4.3"
  }
}
