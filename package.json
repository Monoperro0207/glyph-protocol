{
  "name": "glyph",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "author": "Patrick Espino",
  "workspaces": [
    "packages/*",
    "packages/adapters/*",
    "examples/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test packages/*/test/*.test.ts packages/adapters/*/test/*.test.ts",
    "smoke": "node scripts/smoke-test.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^20.12.12",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
